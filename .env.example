# DeepSeek V3 API Configuration
# Copy this file to .env and fill in your actual values

# Required: Your DeepSeek API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: DeepSeek API endpoint (use default if not specified)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Optional: Model identifier
DEEPSEEK_MODEL=deepseek-chat

# Optional: Temperature for response generation (0.0-1.0, lower = more consistent)
DEEPSEEK_TEMPERATURE=0.3

# Optional: Maximum tokens for response
DEEPSEEK_MAX_TOKENS=2000

# Optional: Enable multimodal features (image analysis)
DEEPSEEK_ENABLE_MULTIMODAL=true

# Optional: Enable internet context for additional information
DEEPSEEK_ENABLE_INTERNET=false

# Optional: Request timeout in milliseconds
DEEPSEEK_TIMEOUT=30000

# Optional: Maximum retry attempts for failed requests
DEEPSEEK_MAX_RETRIES=2
