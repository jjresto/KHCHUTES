{
  "name": "TroubleCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "OBD-II code (e.g., P0420)"
    },
    "category": {
      "type": "string",
      "enum": ["powertrain", "chassis", "body", "network"],
      "description": "Code category"
    },
    "description": {
      "type": "string",
      "description": "What the code means"
    },
    "common_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "moderate", "minor"]
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repair_procedures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["code", "description"]
}
